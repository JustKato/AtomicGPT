# AtomicGPT: run ./setup-wizard.sh, or copy this file to .env and edit it.
# CLI flags override these settings.
# Literal KEY=value syntax; quote values containing spaces. No shell execution.
# Paths support a leading ~, $HOME or ${HOME}. No other variable expansion.

# Installation location (only this application folder is replaced).
INSTALL_DIR="${HOME}/Programs/ChatGPT"

# true: download latest; false: use the RPM_PATH below.
DOWNLOAD_LATEST=true
RPM_PATH=""
# Example local package (relative paths resolve beside this .env):
# RPM_PATH="./chatgpt.x86_64.rpm"
RPM_URL="https://persistent.oaistatic.com/codex-app-prod/linux/rpm/latest/chatgpt.x86_64.rpm"

INTEGRATE_DESKTOP=true
KEEP_BACKUP=false
# close: warn and request consent; skip: defer while ChatGPT is running.
IF_RUNNING=close
CLOSE_DELAY=5
